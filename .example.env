# OpenAI API
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"

# Mode: "cloud" (default) or "local" (localhost offline fallback)
APP_MODE="cloud"

# PostgreSQL Database (Required for Cloud mode)
DATABASE_URL=

# Cloudflare R2 Object Storage (Required for Cloud mode)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL= # Optional: custom domain or worker URL
